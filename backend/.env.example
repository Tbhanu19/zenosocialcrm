# Copy to .env and replace the placeholder values. Do not commit .env.
# Local file database. No MySQL server required.
DATABASE_URL=sqlite:///./zenosocialcrm.db
# MySQL alternative:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/zenosocialcrm?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
